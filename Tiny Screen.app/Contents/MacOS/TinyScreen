#!/bin/bash
set -e

# Resolve bundle location
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
MACOS_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
CONTENTS_DIR="$( cd -P "$MACOS_DIR/.." >/dev/null 2>&1 && pwd )"
APP_DIR="$( cd -P "$CONTENTS_DIR/.." >/dev/null 2>&1 && pwd )"
REPO_DIR="$( cd -P "$APP_DIR/.." >/dev/null 2>&1 && pwd )"

# Determine backend directory (in repo or bundled in Contents/Resources)
if [ -f "$CONTENTS_DIR/Resources/backend/app.py" ]; then
    BACKEND_DIR="$CONTENTS_DIR/Resources/backend"
    WORK_DIR="$CONTENTS_DIR/Resources"
elif [ -f "$APP_DIR/backend/app.py" ]; then
    BACKEND_DIR="$APP_DIR/backend"
    WORK_DIR="$APP_DIR"
elif [ -f "$REPO_DIR/backend/app.py" ]; then
    BACKEND_DIR="$REPO_DIR/backend"
    WORK_DIR="$REPO_DIR"
else
    # Default fallback to current working directory
    BACKEND_DIR="$PWD/backend"
    WORK_DIR="$PWD"
fi

cd "$WORK_DIR"

# Locate Python 3 interpreter
PYTHON_BIN=""

# 1. Active virtual environment
if [ -n "$VIRTUAL_ENV" ] && [ -x "$VIRTUAL_ENV/bin/python3" ]; then
    PYTHON_BIN="$VIRTUAL_ENV/bin/python3"
# 2. Local repo virtualenv
elif [ -x "$WORK_DIR/.venv/bin/python3" ]; then
    PYTHON_BIN="$WORK_DIR/.venv/bin/python3"
# 3. User app cache virtualenv
elif [ -x "$HOME/.tiny_ai_screen/venv/bin/python3" ]; then
    PYTHON_BIN="$HOME/.tiny_ai_screen/venv/bin/python3"
# 4. Apple Silicon Homebrew
elif [ -x "/opt/homebrew/bin/python3" ]; then
    PYTHON_BIN="/opt/homebrew/bin/python3"
# 5. Intel Homebrew
elif [ -x "/usr/local/bin/python3" ]; then
    PYTHON_BIN="/usr/local/bin/python3"
# 6. System PATH
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
# 7. macOS system python
elif [ -x "/usr/bin/python3" ]; then
    PYTHON_BIN="/usr/bin/python3"
fi

if [ -z "$PYTHON_BIN" ]; then
    osascript -e 'display alert "Tiny Screen Error" message "Python 3 could not be found on this system. Please install Python 3 or Homebrew to run the companion app." as critical'
    exit 1
fi

# Verify dependencies
MISSING_DEPS=0
"$PYTHON_BIN" -c "import flask, requests, rumps, zeroconf" >/dev/null 2>&1 || MISSING_DEPS=1

if [ "$MISSING_DEPS" -eq 1 ]; then
    if [ -f "$BACKEND_DIR/requirements.txt" ]; then
        osascript -e 'display notification "Installing required dependencies (flask, rumps, zeroconf)..." with title "Tiny Screen Companion"'
        "$PYTHON_BIN" -m pip install -r "$BACKEND_DIR/requirements.txt" >/dev/null 2>&1 || {
            osascript -e 'display alert "Tiny Screen Dependency Error" message "Could not automatically install Python dependencies. Run: pip3 install -r backend/requirements.txt" as critical'
            exit 1
        }
    fi
fi

# Execute backend companion application
export PYTHONUNBUFFERED=1
exec "$PYTHON_BIN" "$BACKEND_DIR/app.py" "$@"
